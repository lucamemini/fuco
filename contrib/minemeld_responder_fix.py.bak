#!/usr/bin/env python3
from cortexutils.responder import Responder
import requests
import json
import ipaddress
import re
from urllib.parse import urlparse
import urllib3
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

URL_REGEX = re.compile(r'^https?://[^\s/$.?#].[^\s]*$', re.IGNORECASE)
DOMAIN_REGEX = re.compile(r'^(?!-)([A-Za-z0-9-]{1,63}(?<!-)\.)+[A-Za-z]{2,63}$')
EMAIL_REGEX = re.compile(r'^[^@\s]+@[^@\s]+\.[^@\s]+$')

class Minemeld(Responder):
    def __init__(self):
        Responder.__init__(self)
        self.minemeld_url = self.get_param('config.minemeld_url', None, 'URL missing!')
        self.minemeld_user = self.get_param('config.minemeld_user', None, 'Username missing!')
        self.minemeld_password = self.get_param('config.minemeld_password', None, 'Password missing!')
        self.minemeld_indicator_list = self.get_param('config.minemeld_indicator_list', None, "List missing!")
        self.minemeld_share_level = self.get_param('config.minemeld_share_level', None, "Share level missing!")
        self.minemeld_confidence = self.get_param('config.minemeld_confidence', None, "Confidence level missing!")
        self.minemeld_ttl = self.get_param('config.minemeld_ttl', None, "TTL missing!")

        self.observable_type = self.get_param('data.dataType', None, "Data type is empty")
        self.observable_description = self.get_param('data.message', None, "Message is empty")
        self.observable = self.get_param('data.data', None, "Data is empty")


    def _map_indicator_type(self):
        # Minemeld supports: IPv4, IPv6, URL, domain, user-id, md5, sha1, sha256, ssdeep, email-addr
        obs_type = (self.observable_type or '').lower()
        value = (self.observable or '').strip()

        if obs_type == "ip":
            try:
                ipaddress.IPv4Address(value)
                return "IPv4"
            except ValueError:
                try:
                    ipaddress.IPv6Address(value)
                    return "IPv6"
                except ValueError:
                    return None

        if obs_type == "url":
            parsed = urlparse(value)
            if parsed.scheme in {"http", "https"} and parsed.netloc:
                return "URL"
            return None

        if obs_type in {"domain", "fqdn"}:
            if DOMAIN_REGEX.match(value):
                return "domain"
            return None

        if obs_type in {"mail", "email", "email-addr"}:
            if EMAIL_REGEX.match(value):
                return "email-addr"
            return None

        if obs_type in {"user", "user-id"}:
            return "user-id"

        if obs_type == "hash":
            if re.fullmatch(r"[A-Fa-f0-9]{32}", value):
                return "md5"
            if re.fullmatch(r"[A-Fa-f0-9]{40}", value):
                return "sha1"
            if re.fullmatch(r"[A-Fa-f0-9]{64}", value):
                return "sha256"
            # ssdeep heuristic (hash:colon:hash)
            if re.fullmatch(r"\d+:[A-Za-z0-9+/=]{1,}:[A-Za-z0-9+/=]{1,}", value):
                return "ssdeep"
            return None

        if obs_type in {"file", "filename"}:
            return None

        return None

    def run(self):
        Responder.run(self)
        auth = (self.minemeld_user, self.minemeld_password)
        headers = {
            "Content-Type": "application/json"
        }

        indicator_type = self._map_indicator_type()
        if not indicator_type:
            self.error({'message': f"Unsupported indicator type: {self.observable_type}"})
            return

        # Check for comment
        if not self.observable_description:
            comment = "Indicator submitted from TheHive"
        else:
            comment = self.observable_description

        # Build our payload
        payload = {
            "indicator": self.observable,
            "type": indicator_type,
            "comment": comment,
            "share_level": self.minemeld_share_level,
            "confidence": self.minemeld_confidence
        }
        if self.minemeld_ttl is not None and str(self.minemeld_ttl).strip() != "":
            try:
                payload["ttl"] = int(self.minemeld_ttl)
            except (TypeError, ValueError):
                pass

        #print(f"Payload: {json.dumps(payload, indent=2)}\n")

        # Send our request
        try:
            r = requests.post(str(self.minemeld_url) + '/config/data/' + str(self.minemeld_indicator_list) + '_indicators' + '/append?h=' + str(self.minemeld_indicator_list) + '&t=localdb',data=json.dumps(payload),headers=headers,auth=auth,verify=False,timeout=25)
            self.report({'message': "Indicator " + self.observable + " submitted to Minemeld."  })
        except Exception as e:
            self.error({'message': str(e) })

    def operations(self, raw):
        return [self.build_operation('AddTagToCase', tag='Minemeld:Indicator Added')]

if __name__ == '__main__':
        Minemeld().run()
